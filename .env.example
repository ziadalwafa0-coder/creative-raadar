# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Persistent storage directories
DATA_DIR="./.data"
DOWNLOADS_DIR="./.data/downloads"
MAX_CACHE_GB="5"

# Security & Access Control (Required in production)
CREATIVE_RADAAR_PEPPER=""
ACCESS_CODE_DIGESTS=""

# Optional Scraper Proxy / API Key for Amazon anti-bot bypass
SCRAPER_PROXY_URL=""
SCRAPER_API_KEY=""

# Built-in free Scrapling HTTP transport. Enabled automatically in Docker.
SCRAPLING_ENABLED="0"
SCRAPLING_PYTHON="python3"

# Optional Gemini Model Fallback Chain (comma-separated)
GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite"
