{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{"source":"/api/:path*","destination":"/api"}],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "excludeFiles": "{.data/**,.aistudio/**,public/**,dist/**,**/*.test.ts}"
    }
  }
}
