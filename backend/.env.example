PORT=4320
SOURCE=public
FRONTEND_ORIGINS=https://creative-raadar.vercel.app,http://127.0.0.1:5173,http://localhost:5173
SESSION_SECRET=
ADMIN_KEY=
TRUST_PROXY=false
REQUIRE_PROXY=false
# Set to 1 on a 0.5 GB host. Never more than 2 simultaneous browser contexts.
BROWSER_CONCURRENCY=2
# Fixed residential endpoint for each marketplace country. Comma-separated failovers are optional.
PROXY_URL=
PROXY_URL_US=
PROXY_URL_EG=
PROXY_URL_SA=
PROXY_URL_AE=
# gateway = normalized POST contract; unwrangle = documented Unwrangle API (US only).
PROVIDER_KIND=gateway
PROVIDER_API_URL=
PROVIDER_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional query naming; when absent, browser uses lexicon/Chrome Translator/MyMemory.
# Use only a project without billing to keep usage free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
